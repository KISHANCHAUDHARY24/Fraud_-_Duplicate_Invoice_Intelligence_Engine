# Copy this file to .env and fill in real values.  NEVER commit .env
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SECRET_KEY=
DEBUG=True
# Set to True only when the site is served over HTTPS (secure cookies, HTTPS redirect, HSTS)
HTTPS=False
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- PostgreSQL ---
DATABASE_NAME=expense_intelligence
DATABASE_USER=expense_app
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# --- JWT (used from Phase 3) ---
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
LOGIN_RATE_LIMIT=10/min

# --- Bank account hashing (used from Phase 2) ---
BANK_HASH_KEY=

# --- CORS: React dev server origin (no trailing slash) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- FastAPI ML service (used from Phase 9) ---
FASTAPI_URL=http://127.0.0.1:8001
ML_SERVICE_API_KEY=
ML_SERVICE_TIMEOUT=10
